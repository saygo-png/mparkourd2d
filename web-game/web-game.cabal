cabal-version: 2.4
name:          web-game
version:       0
synopsis:      Browser bindings for games built with GHC's wasm backend
build-type:    Simple
author:        saygo-png
maintainer:    saygo-png <saygo.mail@proton.me>

library
  hs-source-dirs:     src
  exposed-modules:
    Web.Box2D
    Web.Canvas
    Web.Frame
    Web.Input

  build-depends:      base, containers, ghc-experimental, linear, text
  default-language:   GHC2024
  default-extensions:
    MultilineStrings
    OverloadedRecordDot

  ghc-options:        -Wall
